# -----------------------------------------------------------------------------
# Aegis Shield backend
#
# `server/env.ts` reads these from the process environment first and only then from
# `.env`. On Windows, `npm run env:to-user` copies them into the User environment so
# `.env` can stay free of secrets - which is why it no longer needs to exist for the
# backend at all.
#
# Leave them unset (or commented out) to use the in-memory dev store. Production refuses
# to start without persistent Supabase storage. Never commit a service-role key: `.env`
# is git-ignored, but the pre-commit hook is the real guard.
# -----------------------------------------------------------------------------

# Supabase -> Project Settings -> API.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Backend bind address. 127.0.0.1 keeps it off your LAN.
HOST=127.0.0.1
PORT=8787

# Development-only shared key for a local backend/client pair. Do not use this for production:
# desktop applications cannot keep shared secrets private. Production uses verified sessions.
AEGIS_API_KEY=dev-local-shared-key

# Force a store regardless of the Supabase values above: `memory` or `supabase`.
# AEGIS_STORE=memory

# Where attachment bytes and their JSON sidecars are written. Relative paths are
# resolved from the directory the backend is started in. Keep it out of source
# control: a 100 MB video is not a commit.
# AEGIS_UPLOAD_DIR=./data/uploads

# -----------------------------------------------------------------------------
# Abuse prevention (docs/05-abuse-prevention.md)
#
# Every one of these is optional; the defaults are the strict ones. Limits are on
# unless AEGIS_RATE_LIMIT=off.
# -----------------------------------------------------------------------------

# `memory` (one process) or `postgres` (shared across instances; run
# Supabase/03-abuse-prevention.sql first).
# AEGIS_RATE_LIMIT_STORE=memory

# `closed` answers 503 for expensive work when the limit store is unreachable;
# `open` allows it instead.
# AEGIS_RATE_LIMIT_FAIL_MODE=closed

# Set to 1 ONLY when a reverse proxy you control overwrites x-forwarded-for.
# Otherwise a client can invent a new address per request and bypass the limits.
# AEGIS_TRUST_PROXY=1

# Enables GET /api/security/{summary,events,cases} and POST /api/security/overrides.
# When empty those routes answer 404. Use a long random value, not AEGIS_API_KEY.
# AEGIS_ADMIN_KEY=

# -----------------------------------------------------------------------------
# Accounts and sign-in
#
# Email/password accounts and their sessions live in a JSON file. It is git-ignored
# (`data/` is), written atomically, and passwords are scrypt hashes - the file never
# contains a usable password or session token. `memory` keeps accounts only for the
# life of the process, which is what the smoke test uses.
# -----------------------------------------------------------------------------
# AEGIS_AUTH_FILE=./data/auth.json

# Require a signed-in session for every API route except /api/health and /api/auth/*.
# AEGIS_REQUIRE_AUTH=1

# The public backend address providers redirect back to. It must match what you register with each
# provider, byte for byte: <AEGIS_PUBLIC_URL>/api/auth/oauth/callback
# AEGIS_PUBLIC_URL=http://127.0.0.1:8787

# Discord -> Developer Portal -> OAuth2 -> Redirects.
# Add http://127.0.0.1:8787/api/auth/oauth/callback
# AEGIS_DISCORD_CLIENT_ID=
# AEGIS_DISCORD_CLIENT_SECRET=

# Google -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# AEGIS_GOOGLE_CLIENT_ID=
# AEGIS_GOOGLE_CLIENT_SECRET=

# Apple -> Certificates, Identifiers & Profiles -> Services ID, plus a
# "Sign in with Apple" key (.p8). The key is PEM text on one line with literal \n
# escapes; `server/oauth.ts` turns them back into newlines. Apple requires an HTTPS
# redirect domain, so a plain 127.0.0.1 callback only works behind a tunnel.
# AEGIS_APPLE_CLIENT_ID=
# AEGIS_APPLE_TEAM_ID=
# AEGIS_APPLE_KEY_ID=
# AEGIS_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# AEGIS_APPLE_REDIRECT_URI=

# Forward moderation incidents to an external reviewer. Failures are swallowed.
# AEGIS_MODERATION_WEBHOOK=

# HMAC key for the `ipHash` in the security log. Unset = random per process, which
# keeps events unlinkable across restarts.
# AEGIS_LOG_SALT=

# -----------------------------------------------------------------------------
# Renderer
#
# Vite bakes these into the renderer at build time. These values below are local-development
# settings only. For a production release set AEGIS_MASTER_SERVER_URL to the deployed HTTPS API
# URL and run `npm run dist`; this disables the dev sign-in bypass and embeds no shared API key.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_API_KEY=dev-local-shared-key

# Local login skip (development only). Adds a "continue as the local dev account" link to the
# login screen: the renderer enters the workspace as the local "dev" account and never asks the
# backend for a session, riding the same `x-aegis-user` claim a fresh checkout already uses, so
# nothing new is trusted on the server. It only works against a loopback VITE_API_BASE_URL, loses
# to AEGIS_REQUIRE_AUTH=1, and is off unless set - leave it commented in any build you hand to
# someone else. Production `npm run dist` disables and removes this bypass. See
# src/state/devSession.ts.
# VITE_AEGIS_SKIP_AUTH=1
